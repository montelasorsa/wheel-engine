# Tracked template for .env. Copy to .env and fill in; .env is gitignored.
#
# Three concerns, three locations (AGENTS.md §3):
#   .env          secrets      gitignored, this file is its tracked template
#   config.yaml   behavior     gitignored, config/example.yaml is its template
#   governance/   rules        tracked
#
# An API key never appears in config.yaml, config/example.yaml, or any tracked
# file. FMP is a bounded null-fill fallback for Stage 2 snapshots, not a primary
# source -- see src/wheel_mcp/fmp.py.
FMP_API_KEY=your_key_here
